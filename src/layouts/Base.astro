---
import '../styles/brand.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, jsonld = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'No Fluff Cruising',
  url: Astro.site?.href,
  logo: new URL('/avatar.png', Astro.site).href,
  description: 'Expert cruise tips, ship reviews and ship tours. No line loyalty, no filler.',
  sameAs: ['https://www.youtube.com/@nofluffcruising'],
};
const graph = [org, ...jsonld];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="No Fluff Cruising" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/avatar.png" />
  <link rel="alternate" type="application/rss+xml" title="No Fluff Cruising" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@500&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header path={path} />
  <slot name="hero" />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
