---
import Base from './Base.astro';
import { getCollection } from 'astro:content';
import VideoFacade from '../components/VideoFacade.astro';
import Sources from '../components/Sources.astro';
import Sponsor from '../components/Sponsor.astro';
import WatchNext from '../components/WatchNext.astro';
import VideosReferenced from '../components/VideosReferenced.astro';
import { easternCalendarDate, formatEasternDisplay, formatEasternISO } from '../utils/etDate.js';
import { formatDayHeading } from '../utils/newsToday.js';
import { newsHubSlug } from '../utils/newsLines.js';

const {
  entry,
  kind = 'Review',
  section = 'Guides',
  sectionUrl = '/guides/',
  schemaType = 'Article',
  preferredSource = false,
} = Astro.props;
const d = entry.data;
const published = d.publishedAt ?? d.publishDate;
const updated = d.updatedAt ?? d.updatedDate ?? published;
const publishedISO = formatEasternISO(published);
const updatedISO = formatEasternISO(updated);
const publishedLabel = formatEasternDisplay(published);
const updatedLabel = formatEasternDisplay(updated);
const showUpdated = new Date(updated).getTime() !== new Date(published).getTime();
const authorUrl = new URL(`/${d.presenter.toLowerCase()}/`, Astro.site).href;
const logoUrl = new URL('/avatar.png', Astro.site).href;
// Hero: an explicit image wins, then the video's own thumbnail (real photography of a real
// presenter, which is the point), then the channel's wake shot as a branded fallback.
const hero = d.heroImage ?? (d.video ? `https://i.ytimg.com/vi/${d.video.id}/maxresdefault.jpg` : '/hero-wake.jpg');
// maxresdefault does not exist for every upload; hqdefault always does.
const heroFallback = d.video && !d.heroImage ? `https://i.ytimg.com/vi/${d.video.id}/hqdefault.jpg` : null;
const heroCredit = d.heroCredit ?? (d.video && !d.heroImage ? `Still from the No Fluff Cruising video "${d.video.title}" on YouTube.` : null);
const newsDay = schemaType === 'NewsArticle' ? easternCalendarDate(published) : null;
const todayKey = newsDay ? easternCalendarDate(new Date()) : null;
const roundupHref = newsDay ? (newsDay === todayKey ? '/news/today/' : `/news/today/${newsDay}/`) : null;
const roundupLabel = newsDay ? (newsDay === todayKey ? 'Cruise news today' : `Cruise news for ${formatDayHeading(newsDay)}`) : null;
const article = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: d.title,
  description: d.answer,
  datePublished: publishedISO,
  dateModified: updatedISO,
  author: {
    '@type': 'Person',
    name: d.presenter,
    url: authorUrl,
    sameAs: ['https://www.youtube.com/@nofluffcruising'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'No Fluff Cruising',
    url: Astro.site?.href,
    logo: { '@type': 'ImageObject', url: logoUrl, width: 256, height: 256 },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  citation: (d.sources ?? []).map((s) => s.outlet),
};
const video = d.video ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: d.video.title,
  description: d.answer,
  thumbnailUrl: `https://i.ytimg.com/vi/${d.video.id}/maxresdefault.jpg`,
  uploadDate: publishedISO,
  embedUrl: `https://www.youtube-nocookie.com/embed/${d.video.id}`,
  contentUrl: `https://www.youtube.com/watch?v=${d.video.id}`,
} : null;
const faq = (d.faq?.length) ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
const jsonld = [article, video, faq].filter(Boolean);
const topicLabel = (d.topics ?? []).filter(Boolean).join(' · ');
const newsHub = schemaType === 'NewsArticle' ? newsHubSlug(d.line) : null;
const linkedShips = [];
if (schemaType === 'NewsArticle' && d.ships?.length) {
  const shipEntries = await getCollection('ships');
  const seenShips = new Set();
  for (const token of d.ships) {
    const match = shipEntries.find((ship) => ship.data.id === token || ship.data.name === token);
    if (!match) continue;
    const href = `/ships/${match.data.line}/${match.data.id}/`;
    if (seenShips.has(href)) continue;
    seenShips.add(href);
    linkedShips.push({ href, name: match.data.name });
  }
}
---
<Base title={d.title} description={d.description} jsonld={jsonld} ogImage={hero}
      breadcrumbs={[{name: section, url: sectionUrl}, {name: d.title, url: Astro.url.pathname}]}
      published={publishedISO}
      modified={updatedISO}
      author={d.presenter}>
  <div class="wrap">
    <article>
      <span class="eyebrow">
        {d.line ? (newsHub ? <a href={`/news/${newsHub}/`}>{d.line}</a> : d.line) : (topicLabel || kind)}
        {d.line && topicLabel ? ` · ${topicLabel}` : ''}
      </span>
      <h1>{d.title}</h1>
      <div class="byline">
        <img src="/avatar.png" width="42" height="42" alt="" />
        <div>
          <strong><a href={authorUrl}>{d.presenter}</a></strong>
          <span>No Fluff Cruising &middot; <time datetime={publishedISO}>{publishedLabel}</time>{showUpdated && <> &middot; Updated <time datetime={updatedISO}>{updatedLabel}</time></>}</span>
        </div>
      </div>

      <figure class="arthero">
        <img src={hero} width="1280" height="720" alt="" fetchpriority="high"
             data-fallback={heroFallback}
             onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback}" />
        {heroCredit && <figcaption>{heroCredit}</figcaption>}
      </figure>

      <div class="answer"><b>The short answer</b>{d.answer}</div>

      {preferredSource && (
        <p class="preferred">
          <b>Get the story first</b>
          <a href="https://www.google.com/preferences/source?q=nofluffcruising.com" rel="noopener">Add No Fluff Cruising as a preferred source in Google</a>
        </p>
      )}

      {d.video && (
        <div class="card" style="margin:0 0 24px">
          <VideoFacade id={d.video.id} title={d.video.title} />
          <div class="body"><span class="kicker">Watch the video</span><h3>{d.video.title}</h3></div>
        </div>
      )}

      <div class="prose"><slot /></div>

      {linkedShips.length > 0 && (
        <section class="reflist">
          <h2>Ship pages</h2>
          <ul>{linkedShips.map((ship) => <li><a href={ship.href}>{ship.name}</a></li>)}</ul>
        </section>
      )}
      {newsHub && <p><a href={`/news/${newsHub}/`}>More {d.line} news</a></p>}
      {roundupHref && <p><a href={roundupHref}>{roundupLabel}</a></p>}

      {d.faq?.length > 0 && (
        <section class="faq" aria-labelledby="faq-h">
          <h2 id="faq-h">Questions</h2>
          <dl>
            {d.faq.map((item) => (
              <div>
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <Sponsor sponsor={d.sponsor} />
      <Sources sources={d.sources} updated={showUpdated ? updatedLabel : publishedLabel} />
      <VideosReferenced videos={d.videosReferenced} />
      <WatchNext video={d.watchNext} />
    </article>
  </div>
</Base>
