---
import NewsToday from '../../../components/NewsToday.astro';
import { getCollection } from 'astro:content';
import { buildNewsTodayModel } from '../../../utils/newsToday.js';

const posts = (await getCollection('news')).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  line: entry.data.line,
  presenter: entry.data.presenter,
  published: entry.data.publishedAt ?? entry.data.publishDate,
}));
const model = buildNewsTodayModel(posts);
const edition = model.edition(model.today);
---
<NewsToday edition={edition} model={model} mode="live" />
