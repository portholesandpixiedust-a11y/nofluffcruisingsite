---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byPublishDate } from '../../utils/byPublishDate.js';
import { NEWS_LINES, canonicalLine, newsHubSlug } from '../../utils/newsLines.js';
const entries = (await getCollection('news')).sort(byPublishDate);
const fmt = (x) => new Date(x).toLocaleDateString('en-US',{day:'numeric',month:'short',year:'numeric'});
const heading = { watch: 'Ship reviews and video companions', guides: 'Cruise guides', news: 'Cruise news' }['news'];
const hubs = NEWS_LINES.filter((line) => entries.some((entry) => canonicalLine(entry.data.line) === line.name));
---
<Base title="Cruise News: Itinerary Changes, Ships & Policy" description="Cruise news that matters to people who are actually booked. Itinerary changes, new ships, policy shifts, each traced to a named source." breadcrumbs={[{name: heading, url: Astro.url.pathname}]}>
  <div class="wrap">
    <span class="eyebrow">news</span>
    <h2 class="sec">{heading}</h2>
    <div class="rule"></div>
    {hubs.length > 0 && (
      <p style="margin:-4px 0 22px;font-size:15px;line-height:1.8">
        {hubs.map((hub, index) => (
          <span>{index > 0 ? ' · ' : ''}<a href={`/news/${hub.hub}/`}>{hub.name}</a></span>
        ))}
      </p>
    )}
    <p style="max-width:70ch;margin:-4px 0 18px">Today's stories are on <a href="/news/today/">cruise news today</a>. Port skips, delays, and swaps from these posts are listed on the <a href="/trackers/itinerary-changes/">itinerary change tracker</a>. Sailings tied to Hurricane Rachel are on the <a href="/trackers/hurricane-rachel/">Hurricane Rachel cruise tracker</a>.</p>
    <div class="news-list">
      {entries.map((e) => (
        <article class="news-row">
          {e.data.heroImage && (
            <a class="news-thumb" href={'/news/' + e.id + '/'} aria-hidden="true" tabindex="-1">
              <img src={e.data.heroImage} width="320" height="180" loading="lazy" alt="" />
            </a>
          )}
          <div class="news-body">
            <span class="kicker">
              {newsHubSlug(e.data.line)
                ? <a href={`/news/${newsHubSlug(e.data.line)}/`}>{e.data.line}</a>
                : e.data.line}
              {e.data.topics?.length ? `${e.data.line ? ' · ' : ''}${e.data.topics.join(' · ')}` : ''}
            </span>
            <h3><a href={'/news/' + e.id + '/'}>{e.data.title}</a></h3>
            {e.data.description && <p>{e.data.description}</p>}
            <span class="meta">{e.data.presenter + ' · ' + fmt(e.data.publishDate)}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
