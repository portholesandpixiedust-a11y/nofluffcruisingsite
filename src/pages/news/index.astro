---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byPublishDate } from '../../utils/byPublishDate.js';
const entries = (await getCollection('news')).sort(byPublishDate);
const fmt = (x) => new Date(x).toLocaleDateString('en-US',{day:'numeric',month:'short',year:'numeric'});
const heading = { watch: 'Ship reviews and video companions', guides: 'Cruise guides', news: 'Cruise news' }['news'];
---
<Base title="Cruise News: Itinerary Changes, Ships & Policy" description="Cruise news that matters to people who are actually booked. Itinerary changes, new ships, policy shifts, each traced to a named source." breadcrumbs={[{name: heading, url: Astro.url.pathname}]}>
  <div class="wrap">
    <span class="eyebrow">news</span>
    <h2 class="sec">{heading}</h2>
    <div class="rule"></div>
    <div class="news-list">
      {entries.map((e) => (
        <article class="news-row">
          {e.data.heroImage && (
            <a class="news-thumb" href={'/news/' + e.id + '/'} aria-hidden="true" tabindex="-1">
              <img src={e.data.heroImage} width="320" height="180" loading="lazy" alt="" />
            </a>
          )}
          <div class="news-body">
            <span class="kicker">{[e.data.line, ...e.data.topics].filter(Boolean).join(' · ')}</span>
            <h3><a href={'/news/' + e.id + '/'}>{e.data.title}</a></h3>
            {e.data.description && <p>{e.data.description}</p>}
            <span class="meta">{e.data.presenter + ' · ' + fmt(e.data.publishDate)}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
