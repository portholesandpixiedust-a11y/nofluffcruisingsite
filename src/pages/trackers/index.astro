---
import Base from '../../layouts/Base.astro';
import TrackerNav from '../../components/TrackerNav.astro';
---
<Base title="Cruise Trackers: Itinerary Changes and CDC Scores" description="Two reference lists for people who are already booked: recent itinerary changes from our news, and CDC Vessel Sanitation scores from the Green Sheet." breadcrumbs={[{name:"Trackers", url:"/trackers/"}]}>
  <div class="wrap">
    <span class="eyebrow">Trackers</span>
    <h1 class="sec">Cruise trackers</h1>
    <div class="rule"></div>
    <TrackerNav current="index" />
    <div class="answer" style="max-width:70ch"><b>The short answer</b>Two lists you can scan before you sail. Itinerary changes we have already published, and CDC sanitation scores taken from the CDC Green Sheet.</div>
    <div class="grid g2c">
      <a class="card" href="/trackers/itinerary-changes/">
        <div class="body">
          <span class="kicker">From our news</span>
          <h3>Itinerary changes</h3>
          <p>Port skips, delays, and swaps, with the ship, the line, the sailing window, and what changed for you. Each row links to the news post that names the source.</p>
        </div>
      </a>
      <a class="card" href="/trackers/cdc-scores/">
        <div class="body">
          <span class="kicker">CDC Vessel Sanitation Program</span>
          <h3>CDC scores</h3>
          <p>Ship, cruise line, score, and inspection date from the CDC Green Sheet. A score of 86 or higher is satisfactory on the CDC's own scale.</p>
        </div>
      </a>
    </div>
  </div>
</Base>

<style>
  a.card{text-decoration:none;color:inherit}
  a.card:hover h3{color:var(--orange-ink)}
</style>
