---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
// Keep in sync with the same allowlist in src/pages/index.astro — the
// auto-publish pipeline drops every approved video companion post into the
// "reviews" collection whether or not it's a real per-ship review.
const FEATURED_REVIEW_IDS = ['celebrity-beyond-review'];
const entries = (await getCollection('reviews'))
  .filter((r) => FEATURED_REVIEW_IDS.includes(r.id))
  .sort((a,b)=> new Date(b.data.publishDate)-new Date(a.data.publishDate));
const fmt = (x) => new Date(x).toLocaleDateString('en-US',{day:'numeric',month:'short',year:'numeric'});
const heading = 'Ship reviews';
---
<Base title="Cruise Ship Reviews" description="Honest cruise ship reviews from people who sailed the ship. No line loyalty, no sponsored verdicts." breadcrumbs={[{name: heading, url: Astro.url.pathname}]}>
  <div class="wrap">
    <span class="eyebrow">Ship reviews</span>
    <h2 class="sec">{heading}</h2>
    <div class="rule"></div>
    <div class="grid g3">
      {entries.map((e) => (
        <Card href={'/reviews/' + e.id + '/'} title={e.data.title} description={e.data.description}
              kicker={[e.data.line, ...e.data.topics].filter(Boolean).join(' · ')}
              videoId={e.data.video?.id} meta={e.data.presenter + ' · ' + fmt(e.data.publishDate)} />
      ))}
    </div>
  </div>
</Base>
