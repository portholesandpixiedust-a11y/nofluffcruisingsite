---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const lines = await getCollection('lines');
  return lines.map((l) => ({ params: { line: l.data.id }, props: { line: l } }));
}
const { line } = Astro.props;
const d = line.data;
const ships = (await getCollection('ships')).filter((s)=>s.data.line===d.id).sort((a,b)=>(b.data.inService??0)-(a.data.inService??0));
const posts = (await getCollection('reviews')).filter((p)=>p.data.line===d.name);
const fmt = (x) => new Date(x).toLocaleDateString('en-US',{day:'numeric',month:'short',year:'numeric'});
---
<Base title={`${d.name} — ships, reviews and guides | No Fluff Cruising`} description={d.blurb}>
  <div class="wrap">
    <span class="eyebrow">Cruise line</span>
    <h1 style="font-family:var(--fd);text-transform:uppercase;font-size:clamp(30px,5vw,46px);line-height:1;margin:6px 0 14px">{d.name}</h1>
    <p style="max-width:70ch;font-size:18px;color:var(--ink-2)">{d.blurb}</p>

    <h2 class="sec" style="margin-top:30px">Ships</h2><div class="rule"></div>
    <div class="scroller"><table>
      <thead><tr><th scope="col">Ship</th><th scope="col">Class</th><th scope="col">Guests</th><th scope="col">In service</th></tr></thead>
      <tbody>{ships.map((s)=>(<tr><td><a href={`/ships/${d.id}/${s.data.id}/`}>{s.data.name}</a></td><td>{s.data.shipClass}</td><td class="num">{s.data.guests?.toLocaleString()}</td><td class="num">{s.data.inService}</td></tr>))}</tbody>
    </table></div>

    {posts.length > 0 && (<>
      <h2 class="sec" style="margin-top:30px">Reviews</h2><div class="rule"></div>
      <div class="grid g3">{posts.map((p)=>(
        <Card href={`/reviews/${p.id}/`} title={p.data.title} description={p.data.description} videoId={p.data.video.id} meta={fmt(p.data.publishDate)} />
      ))}</div>
    </>)}
  </div>
</Base>
