---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { byPublishDate } from '../utils/byPublishDate.js';
const posts = (await getCollection('reviews')).filter((p)=>p.data.presenter==='Matthew').sort(byPublishDate);
const guides = (await getCollection('guides')).filter((p)=>p.data.presenter==='Matthew').sort(byPublishDate);
const news = (await getCollection('news')).filter((p)=>p.data.presenter==='Matthew').sort(byPublishDate);
const bio = 'Matthew presents expert cruise tips, ship reviews and ship tours on No Fluff Cruising. Between the two presenters, more than 40 cruises across Royal Caribbean, Carnival, Norwegian, MSC, Disney, Princess, Virgin Voyages and Celebrity.';
const jsonld = [{
  '@context':'https://schema.org','@type':'Person',
  name:'Matthew', jobTitle:'Cruise reviewer',
  worksFor:{'@type':'Organization',name:'No Fluff Cruising'},
  url:new URL('/matthew/',Astro.site).href,
  sameAs:['https://www.youtube.com/@nofluffcruising'],
  knowsAbout:['Cruising','Royal Caribbean','Carnival','Norwegian','MSC','Disney','Princess','Virgin Voyages','Celebrity'],
  description: bio
}];
---
<Base title="Matthew, Cruise Reviewer" description="Matthew presents cruise tips, ship reviews and ship tours on No Fluff Cruising." jsonld={jsonld} breadcrumbs={[{name:"Matthew", url:Astro.url.pathname}]}>
  <div class="wrap"><article>
    <span class="eyebrow">Who writes this</span>
    <h1>Matthew</h1>
    <div class="byline"><img src="/avatar.png" width="42" height="42" alt="" /><div><strong>Matthew</strong><span>No Fluff Cruising</span></div></div>
    <div class="prose">
      <p>{bio}</p>
      <p>No line loyalty. Every claim in a video or on this site names its source and its date. Read <a href="/sources/">how we source</a>.</p>
    </div>
    {posts.length > 0 && (<>
      <h2 class="sec" style="margin-top:30px">Reviews by Matthew</h2><div class="rule"></div>
      <div class="grid">{posts.map((p)=>(<Card href={'/reviews/'+p.id+'/'} title={p.data.title} description={p.data.description} videoId={p.data.video.id} />))}</div>
    </>)}
    {guides.length > 0 && (<>
      <h2 class="sec" style="margin-top:30px">Guides by Matthew</h2><div class="rule"></div>
      <div class="grid">{guides.map((p)=>(<Card href={'/guides/'+p.id+'/'} title={p.data.title} description={p.data.description} videoId={p.data.video?.id} />))}</div>
    </>)}
    {news.length > 0 && (<>
      <h2 class="sec" style="margin-top:30px">News by Matthew</h2><div class="rule"></div>
      <div class="grid">{news.map((p)=>(<Card href={'/news/'+p.id+'/'} title={p.data.title} description={p.data.description} image={p.data.heroImage} />))}</div>
    </>)}
  </article></div>
</Base>
