---
const { path = '/' } = Astro.props;
const nav = [
  { href: '/watch/', label: 'Reviews' },
  { href: '/guides/', label: 'Guides' },
  { href: '/news/', label: 'News' },
  { href: '/ships/', label: 'Ships' },
  { href: '/sources/', label: 'How we source' },
];
---
<header class="site">
  <div class="wrap bar">
    <a class="brand" href="/">
      <img src="/avatar.png" width="40" height="40" alt="" />
      <span class="wm">No Fluff Cruising<small>Expert tips &middot; Ship reviews &middot; Ship tours</small></span>
    </a>
    <nav class="main" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a class="quote" href="https://yourcruisebestie.com/free-quote" rel="noopener">Free Quote</a>
  </div>
</header>
