---
/**
 * beehiiv subscribe-form embed (v3 loader).
 * Default form ID is the live No Fluff Cruising signup form.
 * Override with PUBLIC_BEEHIIV_FORM_ID in Vercel if you rotate forms.
 */
const formId = (import.meta.env.PUBLIC_BEEHIIV_FORM_ID || 'd769eb81-bf6c-442c-96b6-7097f59a9f52').trim();
const hasForm = Boolean(formId);
---
<div class="nfc-nl-embed">
  {hasForm ? (
    <script
      is:inline
      async
      src="https://subscribe-forms.beehiiv.com/v3/loader.js"
      data-beehiiv-form={formId}
    ></script>
  ) : (
    <div class="nlform nfc-nl-fallback" aria-live="polite">
      <label class="visually-hidden" for="nfc-nl-email-soon">Email</label>
      <input
        id="nfc-nl-email-soon"
        type="email"
        name="email"
        placeholder="you@example.com"
        disabled
        autocomplete="email"
      />
      <button class="btn" type="button" disabled>Signup opens soon</button>
      <p class="nfc-nl-note">Coming soon. Form ID not set yet.</p>
    </div>
  )}
</div>

<style>
  .nfc-nl-embed { width: 100%; min-width: 0; min-height: 120px; }
  .nfc-nl-fallback { flex-direction: column; align-items: stretch; }
  .nfc-nl-fallback .btn[disabled],
  .nfc-nl-fallback input[disabled] {
    opacity: 0.75;
    cursor: not-allowed;
  }
  .nfc-nl-note {
    margin: 4px 0 0;
    font-family: var(--fu);
    font-size: 12px;
    color: var(--onnavy-2);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
