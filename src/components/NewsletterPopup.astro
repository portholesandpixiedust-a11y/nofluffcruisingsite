import NewsletterEmbed from './NewsletterEmbed.astro';
---
{/* Homepage-only popup. Timer + localStorage live in the client script below. */}
<div
  id="nfc-nl-popup"
  class="nfc-nl-popup"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="nfc-nl-popup-title"
  aria-describedby="nfc-nl-popup-desc"
>
  <div class="nfc-nl-popup__backdrop" data-nfc-nl-dismiss tabindex="-1"></div>
  <div class="nfc-nl-popup__panel" role="document">
    <button
      type="button"
      class="nfc-nl-popup__close"
      data-nfc-nl-dismiss
      aria-label="Close newsletter signup"
    >×</button>
    <span class="eyebrow" style="color:var(--orange)">Newsletter</span>
    <h2 id="nfc-nl-popup-title">No Fluff Weekly</h2>
    <p id="nfc-nl-popup-desc">
      Cruise news, guides, reviews, and a little chaos. Short. Sourced. No fluff.
      <a href="/privacy/">Privacy</a>.
    </p>
    <NewsletterEmbed />
  </div>
</div>

<script>
  (() => {
    const KEY = 'nfc-nl-dismissed';
    const TTL_MS = 30 * 24 * 60 * 60 * 1000; // 30 days
    const DELAY_MS = 10_000;
    const root = document.getElementById('nfc-nl-popup');
    if (!root) return;

    // Homepage only (Astro directory URLs may be "/" or "/index.html").
    const path = location.pathname.replace(/\/index\.html$/, '/') || '/';
    if (path !== '/') return;

    const readDismissed = () => {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return false;
        const ts = Number(raw);
        if (!Number.isFinite(ts)) {
          localStorage.removeItem(KEY);
          return false;
        }
        if (Date.now() - ts > TTL_MS) {
          localStorage.removeItem(KEY);
          return false;
        }
        return true;
      } catch {
        return false;
      }
    };

    const remember = () => {
      try {
        localStorage.setItem(KEY, String(Date.now()));
      } catch {
        /* private mode: still allow dismiss for this session */
      }
    };

    let previouslyFocused = null;
    let open = false;

    const focusables = () =>
      Array.from(
        root.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), iframe, [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => el.offsetParent !== null || el === document.activeElement);

    const close = () => {
      if (!open) return;
      open = false;
      root.hidden = true;
      document.body.classList.remove('nfc-nl-popup-open');
      remember();
      document.removeEventListener('keydown', onKey);
      if (previouslyFocused && typeof previouslyFocused.focus === 'function') {
        previouslyFocused.focus();
      }
    };

    const onKey = (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab' || !open) return;
      const list = focusables();
      if (list.length === 0) return;
      const first = list[0];
      const last = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    const show = () => {
      if (open || readDismissed()) return;
      open = true;
      previouslyFocused = document.activeElement;
      root.hidden = false;
      document.body.classList.add('nfc-nl-popup-open');
      document.addEventListener('keydown', onKey);
      const closeBtn = root.querySelector('.nfc-nl-popup__close');
      if (closeBtn) closeBtn.focus();
    };

    root.querySelectorAll('[data-nfc-nl-dismiss]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        close();
      });
    });

    if (readDismissed()) return;

    const reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const delay = reduceMotion ? 0 : DELAY_MS;
    window.setTimeout(show, delay);
  })();
</script>
