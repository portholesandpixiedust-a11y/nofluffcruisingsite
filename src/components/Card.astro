---
const { href, title, kicker, description, meta, videoId, image } = Astro.props;
const thumb = image || (videoId ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg` : null);
---
<article class="card">
  {thumb && (
    <a href={href} aria-hidden="true" tabindex="-1" class="card-thumb">
      <img src={thumb} width="480" height="270" loading="lazy" alt="" style="aspect-ratio:16/9;object-fit:cover;width:100%" />
    </a>
  )}
  <div class="body">
    {kicker && <span class="kicker">{kicker}</span>}
    <h3><a href={href}>{title}</a></h3>
    {description && <p>{description}</p>}
    {meta && <span class="meta">{meta}</span>}
  </div>
</article>
